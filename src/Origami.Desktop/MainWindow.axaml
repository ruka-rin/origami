<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Origami.Desktop"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Origami.Desktop.MainWindow"
        Title="折纸谜题工具 — 母版到成品"
        Width="1280" Height="720" MinWidth="1000" MinHeight="560"
        Background="{StaticResource Bgc.Base}">

  <Window.Styles>
    <!--
      画布浮层：实心面板 + 淡边框，与画布底色有明确层次。
      之前用 #B01A1A1F（半透明），实测在深色画布上几乎看不出来，
      浮层像是「悬空」且点不准 —— 半透明压低了对比度。

      常驻时已是实心够亮的深灰（#26262C），悬停再提亮一档，
      这样既不喧宾夺主，又能第一眼看到控件在哪。
    -->
    <Style Selector="Border.overlay">
      <Setter Property="Background" Value="#26262C" />
      <Setter Property="CornerRadius" Value="{StaticResource Rounded.Panel}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#3A3A44" />
    </Style>
    <Style Selector="Border.overlay:pointerover">
      <Setter Property="Background" Value="#30303A" />
      <Setter Property="BorderBrush" Value="#4A4A57" />
    </Style>

    <!-- 方向按钮：等宽等高成组，悬停高亮 -->
    <Style Selector="Button.dir">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Fg.Strong}" />
    </Style>
    <Style Selector="Button.dir:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Bgc.Hover}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Button.help:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Bgc.HelpHover}" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource Accent}" />
    </Style>

    <!-- 帮助按钮：与浮层同色，悬停变强调色 -->
    <Style Selector="Button.help">
      <Setter Property="Background" Value="#26262C" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#3A3A44" />
      <Setter Property="Foreground" Value="{StaticResource Fg.Muted}" />
    </Style>
    <Style Selector="Button.help:pointerover">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!-- ═══════════ 左侧面板：输入与文件操作 ═══════════
         垂直排布而非顶部横向：文本框要能分行（折蛇形），母版串很长，
         两者都需要「宽」也「高」。放左侧后右边整块留给画布。 -->
    <Border DockPanel.Dock="Left" Width="330"
            Background="{StaticResource Bgc.Chrome}"
            BorderBrush="{StaticResource Bdr.Hairline}" BorderThickness="0,0,1,0">
      <Grid Margin="16,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="折纸谜题工具" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource Fg.Strong}" Margin="0,0,0,14" />

        <!--
            输入区。文本框<b>常驻</b>，不再用开关切换 ——
            母版框就是文本框的产物，两者并存才说得通；藏起来反而让人
            以为功能不存在。
            文本框在母版框<b>上方</b>：先输入文字，再得到母版，顺序即因果。
        -->
        <StackPanel Grid.Row="1" Spacing="8">
          <TextBlock Classes="section" Text="文本 → 母版" Margin="0,0,0,0" />
          <TextBox x:Name="TextBox"
                   Text="{Binding TextInput}"
                   Watermark="{Binding TextWatermark}"
                   FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
                   FontSize="16"
                   MinHeight="50" MaxHeight="150"
                   MaxLength="200"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalContentAlignment="Top"
                   ToolTip.Tip="可分行输入（分行会折成蛇形）。边打边生成母版，回车用于换行" />

          <TextBlock Classes="section" Text="母版" Margin="0,10,0,0" />
          <TextBox x:Name="MasterBox"
                   Text="{Binding MasterText}"
                   Watermark="母版字符串，例如 /....|../.."
                   FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
                   FontSize="12"
                   MinHeight="100" MaxHeight="240"
                   AcceptsReturn="False"
                   TextWrapping="Wrap"
                   MaxLength="5000"
                   VerticalContentAlignment="Top"
                   KeyDown="OnMasterKeyDown" LostFocus="OnMasterLostFocus"
                   ToolTip.Tip="可直接编辑母版串。回车或点别处即渲染（内容没变则跳过）" />
        </StackPanel>

        <!-- 文件操作。放左下角：与输入区同一条肌肉记忆（改内容 -> 存/取） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
          <Button Content="导入…" MinWidth="88" HorizontalAlignment="Stretch"
                  Click="OnImport" IsEnabled="{Binding !Busy}"
                  ToolTip.Tip="导入母版文本，或长条 / 方形折痕图 SVG（彩色与黑白都支持）" />
          <Button Content="保存…" MinWidth="88" HorizontalAlignment="Stretch"
                  Click="OnSave" IsEnabled="{Binding !Busy}"
                  ToolTip.Tip="导出当前视图：SVG 矢量或 PNG 位图" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══════════ 底栏：状态 ═══════════ -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Bgc.Chrome}">
      <Grid Margin="18,8" ColumnDefinitions="*,Auto,100">
        <TextBlock Grid.Column="0" Text="{Binding Status}" Foreground="{StaticResource Fg.Muted}"
                   ToolTip.Tip="{Binding StatusDetail}"
                   VerticalAlignment="Center" Margin="0,0,20,0"
                   HorizontalAlignment="Left"
                   TextTrimming="CharacterEllipsis" MinWidth="100" MaxWidth="300" />
        <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{StaticResource Fg.Base}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="{Binding ZoomText}" Foreground="{StaticResource Fg.Muted}"
                   VerticalAlignment="Center" Margin="10,0,10,0"
                   TextAlignment="Right" />
      </Grid>
    </Border>

    <!-- ═══════════ 主体：整块画布 ═══════════ -->
    <Grid ClipToBounds="True">
      <local:SvgView x:Name="Viewer" Source="{Binding SvgSource}" />

      <!-- 左上角：形状（长条 / 方形）。GroupName 保证两项互斥。 -->
      <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
              Classes="overlay" Padding="5" Background="#333">
        <StackPanel Orientation="Horizontal" Spacing="0" Opacity="0.8">
          <RadioButton x:Name="ShapeStrip" GroupName="shape"
                       Theme="{StaticResource SegmentOption}" Classes="ghost"
                       Margin="0,0,4,0" Content="长条"
                       IsChecked="{Binding Shape, Mode=OneWay, Converter={StaticResource ShapeToBool}, ConverterParameter=Strip}" />
          <RadioButton x:Name="ShapeSquare" GroupName="shape"
                       Theme="{StaticResource SegmentOption}" Classes="ghost"
                       Content="方形"
                       IsChecked="{Binding Shape, Mode=OneWay, Converter={StaticResource ShapeToBool}, ConverterParameter=Square}" />
        </StackPanel>
      </Border>

      <!-- 右上角：内容（折痕图 / 成品 / 原子片）+ 上色开关 -->
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14"
              Classes="overlay" Padding="5" Background="#333">
        <StackPanel Orientation="Horizontal" Spacing="0" Opacity="0.8">
          <RadioButton x:Name="ContentCrease" GroupName="content"
                       Theme="{StaticResource SegmentOption}" Classes="ghost"
                       Margin="0,0,4,0" Content="折痕图"
                       IsChecked="{Binding Content, Mode=OneWay, Converter={StaticResource ContentToBool}, ConverterParameter=Crease}" />
          <RadioButton x:Name="ContentFolded" GroupName="content"
                       Theme="{StaticResource SegmentOption}" Classes="ghost"
                       Margin="0,0,4,0" Content="成品"
                       IsChecked="{Binding Content, Mode=OneWay, Converter={StaticResource ContentToBool}, ConverterParameter=Folded}" />
          <RadioButton x:Name="ContentPieces" GroupName="content"
                       Theme="{StaticResource SegmentOption}" Classes="ghost"
                       Content="原子片"
                       IsChecked="{Binding Content, Mode=OneWay, Converter={StaticResource ContentToBool}, ConverterParameter=Pieces}" />
          <!-- 上色开关与内容切换用竖线分隔，避免被当成同一组 -->
          <Rectangle Width="1" Margin="8,6" Fill="{StaticResource Bdr.Hairline}" />
          <ToggleSwitch x:Name="ColorSwitch"
                        IsChecked="{Binding IsColorOn, Mode=TwoWay}"
                        IsEnabled="{Binding CanColorize}"
                        OnContent="" OffContent=""
                        VerticalAlignment="Center" Margin="4,0,6,0"
                        ToolTip.Tip="上色：关掉颜色只看形状（折痕图变线稿，成品变剪影）" />
        </StackPanel>
      </Border>

      <!-- 左下角：操作说明 -->
      <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14"
              Classes="help" Content="?"
              Click="OnShowHelp"
              ToolTip.Tip="查看操作说明" />

      <!-- 右下角：画布方向。默认半透明不抢画面，悬停才实心。 -->
      <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14"
              Classes="overlay" Padding="10,8" Background="#333">
        <StackPanel Spacing="7" Opacity="0.8">
          <StackPanel Orientation="Horizontal" Spacing="0">
            <Button Classes="dir" Content="↺" Click="OnRotateCcw"
                    IsEnabled="{Binding !Busy}" ToolTip.Tip="逆时针旋转 90°" />
            <Button Classes="dir" Content="↻" Click="OnRotateCw"
                    IsEnabled="{Binding !Busy}" ToolTip.Tip="顺时针旋转 90°" />
            <Button Classes="dir" Content="⇋" Click="OnMirrorX"
                    IsEnabled="{Binding !Busy}" ToolTip.Tip="左右镜像" />
            <Button Classes="dir" Content="⇅" Margin="0" Click="OnMirrorY"
                    IsEnabled="{Binding !Busy}" ToolTip.Tip="上下镜像" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding XformDescription}"
                       FontSize="10" Foreground="{StaticResource Fg.RsFaint}"
                       VerticalAlignment="Center" Margin="2,0,10,0" />
            <Button Grid.Column="1" Content="复位" FontSize="10.5" Padding="10,3"
                    Click="OnResetXform" IsEnabled="{Binding CanResetXform}"
                    ToolTip.Tip="恢复原始方向（清掉所有旋转与镜像）" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 忙碌遮罩 -->
      <Border IsVisible="{Binding Busy}" Background="{StaticResource Bgc.Scrim}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
          <ProgressBar IsIndeterminate="True" Width="220" Height="4" />
          <TextBlock Text="正在计算…" Foreground="{StaticResource Fg.Base}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- 空状态 -->
      <Border IsVisible="{Binding !HasSvg}" Background="{StaticResource Bgc.Base}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
          <TextBlock Text="输入母版，回车或点别处即自动渲染"
                     Foreground="{StaticResource Fg.Muted}" FontSize="14"
                     HorizontalAlignment="Center" />
          <TextBlock Text="滚轮缩放 · 左键拖动 · 右键复位 · 双击 1:1 · 左下角 ? 看说明"
                     Foreground="{StaticResource Fg.Faint}" FontSize="11.5"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>