<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Origami.Desktop"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Origami.Desktop.MainWindow"
        Title="折纸谜题工具 — 母版到成品"
        Width="1280" Height="720" MinWidth="900" MinHeight="560"
        Background="#16161A">

  <Window.Styles>
    <!-- ★ 按钮文字一律水平居中。Fluent 主题给的是 Stretch，
         按钮一旦被 Grid 拉宽，文字就会贴左，看着像没对齐。 -->
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style Selector="ListBox.viewlist">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.viewlist ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,3" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.viewlist ListBoxItem:pointerover">
      <Setter Property="Background" Value="#23232B" />
    </Style>
    <Style Selector="ListBox.viewlist ListBoxItem:selected">
      <Setter Property="Background" Value="#2A3550" />
    </Style>
    <Style Selector="ListBox.viewlist ListBoxItem:selected:pointerover">
      <Setter Property="Background" Value="#2F3D5E" />
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!-- ══════════════════════ 顶栏 ══════════════════════
         ★ 母版与「文本生成母版」上下两行：母版串是主体，文本只是个入口，
           上下排能让母版框拿到整行宽度（109 字符，横排会被挤到需要滚动）。
         ★ 两个标签用同一个 FontSize（12），否则「母版」比「文本生成母版」明显小一号，
           看着像主次不对等，其实两者是对等的两种输入。 -->
    <Border DockPanel.Dock="Top" Background="#1E1E24" Padding="14,10">
      <StackPanel Spacing="8">

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="折纸谜题工具" VerticalAlignment="Center"
                     FontSize="15" FontWeight="SemiBold" Foreground="#E4E7EC" />
          <TextBlock Grid.Column="1" Foreground="#5E6470" FontSize="11"
                     VerticalAlignment="Center"
                     Text="回车或点别处即渲染" />
        </Grid>

        <!-- 母版行。★ ColumnDefinition.MinWidth 默认是 Auto：即使列宽写 *，
             它也会先按子控件的 DesiredSize 兜底。母版串有 109 字符，
             TextBox 的 DesiredSize 很宽，于是顶栏被撑到比窗口还宽、
             按钮被挤出可视区。所以 * 列必须显式 MinWidth="0"。 -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="0" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="母版" VerticalAlignment="Center"
                     FontSize="12" Foreground="#9AA0AA" Margin="0,0,12,0" MinWidth="42" />

          <TextBox Grid.Column="1" x:Name="MasterBox"
                   Text="{Binding MasterText}"
                   Watermark="输入母版字符串，例如 /....|../.."
                   FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
                   FontSize="13" Padding="8,6" HorizontalAlignment="Stretch"
                   AcceptsReturn="False"
                   KeyDown="OnMasterKeyDown" LostFocus="OnMasterLostFocus"
                   IsEnabled="{Binding !Busy}" />

          <!-- ★ 导入不放对话框：格式（母版文本 / 长条 SVG / 方形 SVG）
               由内容自动判别，直接开文件选择器即可，多一步确认反而多余。 -->
          <Button Grid.Column="2" Content="导入…" MinWidth="88" Margin="8,0,0,0"
                  Padding="14,6" Click="OnImport" IsEnabled="{Binding !Busy}"
                  ToolTip.Tip="导入母版文本，或长条 / 方形折痕图 SVG（彩色与黑白都支持）" />

          <Button Grid.Column="3" Content="保存…" MinWidth="88" Margin="8,0,0,0"
                  Padding="14,6" Click="OnSave" IsEnabled="{Binding !Busy}" />
        </Grid>

        <!-- 文本生成母版行：与上一行同构，标签字号一致（都是 12）。
             ★ 开关与文本框同行相邻：开关的意义就是「旁边那个输入框现在可用」。
               文本框整行拉伸 —— 普通文本虽短，但让它占满剩余宽度，
               「开关 + 输入框」这一组在视觉上就不会比母版那组窄一截。 -->
        <Grid ColumnDefinitions="Auto,Auto,*">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="0" />
          </Grid.ColumnDefinitions>

          <!-- ★ 标签用独立 TextBlock 与开关并排（同「上色」那套），
               否则 ToggleSwitch 会把文字画在滑块旁边、和开关混成一块。
               On/Off 内容置空，说明放 ToolTip。 -->
          <TextBlock Grid.Column="0" Text="文本生成母版" VerticalAlignment="Center"
                     FontSize="12" Foreground="#9AA0AA" Margin="0,0,12,0" MinWidth="42" />

          <ToggleSwitch Grid.Column="1" x:Name="ModeSwitch"
                        IsChecked="{Binding IsTextMode, Mode=TwoWay}"
                        IsEnabled="{Binding !Busy}"
                        OnContent="" OffContent=""
                        VerticalAlignment="Center"
                        ToolTip.Tip="打开后右边出现文本输入框，输入普通文本（如 KRENIO）由折纸字库生成母版" />

          <TextBox Grid.Column="2" x:Name="TextBox"
                   Text="{Binding TextInput}"
                   Watermark="{Binding TextWatermark}"
                   FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
                   FontSize="13" Padding="8,6" HorizontalAlignment="Stretch"
                   AcceptsReturn="False"
                   KeyDown="OnTextKeyDown" LostFocus="OnTextLostFocus"
                   IsVisible="{Binding IsTextMode}"
                   IsEnabled="{Binding !Busy}"
                   ToolTip.Tip="回车或点别处即生成母版，结果写进上面的母版框" />
        </Grid>

      </StackPanel>
    </Border>

    <!-- ══════════════════════ 底栏：状态 ══════════════════════ -->
    <Border DockPanel.Dock="Bottom" Background="#1E1E24" Padding="14,7">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Status}" Foreground="#9AA0AA"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="#C8CDD4"
                   VerticalAlignment="Center" Margin="0,0,18,0" />
        <TextBlock Grid.Column="2" Text="{Binding ZoomText}" Foreground="#9AA0AA"
                   VerticalAlignment="Center" MinWidth="58" TextAlignment="Right" />
      </Grid>
    </Border>

    <!-- ══════════════════════ 主体 ══════════════════════ -->
    <Grid ColumnDefinitions="Auto,*">

      <!-- 左侧：视图选择 + 上色开关。★ 没有缩放按钮面板 ——
           缩放只用鼠标（滚轮缩放 / 拖动平移 / 右键复位 / 双击 1:1）。 -->
      <Border Grid.Column="0" Width="188" Background="#1A1A1F" Padding="10,12">
        <StackPanel Spacing="14">

          <StackPanel Spacing="6">
            <TextBlock Text="视图" FontSize="11" Foreground="#6E7480" />
            <ListBox Classes="viewlist" x:Name="ViewList"
                     ItemsSource="{Binding ViewTabs}"
                     SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                     SelectionChanged="OnTabChanged">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:ViewTab">
                  <Grid ColumnDefinitions="3,Auto,*" Margin="9,7">
                    <Border Grid.Column="0" Width="3" Height="14" CornerRadius="2"
                            Background="#4C8DFF" />
                    <TextBlock Grid.Column="1" Text="{Binding Group}" FontSize="11"
                               Foreground="#7E8592" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <Rectangle Height="1" Fill="#2A2A32" />

          <!-- ★ 上色是一个开关，不是两组视图。
               关：折痕图 -> 题面线稿（全黑），成品 -> 剪影（纯黑块）
               开：折痕图 -> 红峰/蓝谷/绿剪切线，成品 -> 按层序着色

               ★ 标签用独立的 TextBlock 与开关并排，而不是塞进 Content：
                 ToggleSwitch 的 Content 是「开关本体的内容」，会画在滑块旁边，
                 视觉上贴着开关、和它混成一块。分开排才能真正「并排」。
               ★ OnContent / OffContent 置空：ToggleSwitch 默认在里面写On/Off 字样，
                 这里只要开关本身，说明放在 ToolTip。
               ★ 绑定的 IsColorOn 是<b>可写</b>属性，所以 TwoWay 双向绑定即可，
                 不需要 code-behind 兜底。 -->
          <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="Center">
            <TextBlock Grid.Column="0" Text="上色" VerticalAlignment="Center"
                       Foreground="#E4E7EC" FontSize="12" Margin="0,0,10,0" />
            <ToggleSwitch Grid.Column="1" x:Name="ColorSwitch"
                          IsChecked="{Binding IsColorOn, Mode=TwoWay}"
                          IsEnabled="{Binding CanColorize}"
                          OnContent="" OffContent=""
                          VerticalAlignment="Center"
                          ToolTip.Tip="关掉颜色只看形状：折痕图变题面线稿，成品变剪影" />
          </Grid>

          <Rectangle Height="1" Fill="#2A2A32" />

          <!-- ══════ 画布方向 ══════
               ★ 折痕推出来的成品偶尔朝向不对（字母倒了 / 镜像了）。这里给整张图
                 一个方向变换，而不是去改折叠算法的方向约定 —— 同一张母版可以
                 来回对照，而且<b>导出直接继承这里的状态</b>。
               ★ 只提供整点旋转与镜像：任意角度在位图上要重采样（会糊）、
                 在矢量上要变形路径，两边对不上；整点旋转是精确的像素置换。
               ★ 按钮宽高一致（都是 34），两两成对，视觉上对齐。 -->
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="画布方向" FontSize="11" Foreground="#6E7480"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding XformDescription}"
                         FontSize="10" Foreground="#5E6470" VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="34,34,34,34" HorizontalAlignment="Center">
              <Button Grid.Column="0" Content="↺" Width="34" Height="30" Padding="0"
                      Click="OnRotateCcw" IsEnabled="{Binding !Busy}"
                      ToolTip.Tip="逆时针旋转 90°" />
              <Button Grid.Column="1" Content="↻" Width="34" Height="30" Padding="0"
                      Margin="4,0,0,0" Click="OnRotateCw" IsEnabled="{Binding !Busy}"
                      ToolTip.Tip="顺时针旋转 90°" />
              <Button Grid.Column="2" Content="⇋" Width="34" Height="30" Padding="0"
                      Margin="4,0,0,0" Click="OnMirrorX" IsEnabled="{Binding !Busy}"
                      ToolTip.Tip="左右镜像" />
              <Button Grid.Column="3" Content="⇅" Width="34" Height="30" Padding="0"
                      Margin="4,0,0,0" Click="OnMirrorY" IsEnabled="{Binding !Busy}"
                      ToolTip.Tip="上下镜像" />
            </Grid>

            <Button Content="恢复原始方向" Height="26" Padding="8,0" FontSize="11"
                    HorizontalAlignment="Center" Click="OnResetXform"
                    IsEnabled="{Binding CanResetXform}"
                    ToolTip.Tip="清掉所有旋转与镜像" />
          </StackPanel>

          <Rectangle Height="1" Fill="#2A2A32" />

          <StackPanel Spacing="6">
            <TextBlock Text="鼠标操作" FontSize="11" Foreground="#6E7480" />
            <TextBlock FontSize="11" Foreground="#5E6470" TextWrapping="Wrap"
                       LineHeight="17"
                       Text="滚轮 — 缩放（以光标为锚点）&#10;左键拖动 — 平移&#10;右键单击 — 适应窗口&#10;双击 — 1:1 / 适应切换" />
            <TextBlock FontSize="10" Foreground="#4A4E56" TextWrapping="Wrap"
                       LineHeight="15" Margin="0,4,0,0"
                       Text="方向会一并应用到导出的 SVG 与 PNG，导出时不再单独询问。" />
          </StackPanel>

        </StackPanel>
      </Border>

      <!-- 右侧：矢量预览 -->
      <Grid Grid.Column="1" ClipToBounds="True">
        <local:SvgView x:Name="Viewer" Source="{Binding SvgSource}" />

        <!-- 忙碌遮罩 -->
        <Border IsVisible="{Binding Busy}" Background="#D916161A">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressBar IsIndeterminate="True" Width="240" Height="4" />
            <TextBlock Text="正在计算…" Foreground="#C8CDD4" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- 空状态 -->
        <Border IsVisible="{Binding !HasSvg}" Background="#16161A">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
            <TextBlock Text="输入母版，回车或点别处即自动渲染" Foreground="#6E7480"
                       FontSize="15" HorizontalAlignment="Center" />
            <TextBlock Text="滚轮缩放 · 左键拖动 · 右键复位 · 双击 1:1" Foreground="#4A4E56"
                       FontSize="12" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>