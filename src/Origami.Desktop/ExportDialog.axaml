<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="380"
        x:Class="Origami.Desktop.ExportDialog"
        Title="导出" Width="420" Height="400"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bgc.Chrome}">

  <Window.Styles>
    <!-- 选项做成整行可点的卡片，比裸RadioButton 的圆点+文字更易点 -->
    <Style Selector="Border.choice">
      <Setter Property="CornerRadius" Value="{StaticResource Rounded.Control}" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.choice:pointerover">
      <Setter Property="Background" Value="{StaticResource Bgc.Hover}" />
    </Style>
    <Style Selector="Border.choice.on">
      <Setter Property="Background" Value="{StaticResource Accent.Soft}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <!-- 不可用时文字退到最弱一级，与整体禁用态一致 -->
    <Style Selector="TextBlock.disabled">
      <Setter Property="Foreground" Value="{StaticResource Fg.Faint}" />
    </Style>
  </Window.Styles>

  <Grid Margin="22" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
               Foreground="{StaticResource Fg.Strong}" />

    <!-- 格式 -->
    <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="0">
      <TextBlock Classes="section" Text="格式" />
      <Grid ColumnDefinitions="*,*">
        <Border x:Name="SvgChoice" Grid.Column="0" Classes="choice" Margin="0,0,6,0"
                PointerPressed="OnPickSvg">
          <TextBlock Text="SVG 矢量" FontSize="12" Foreground="{StaticResource Fg.Base}" />
        </Border>
        <RadioButton x:Name="SvgRadio" Grid.Column="0" IsHitTestVisible="False"
                     Opacity="0" MinWidth="0" />
        <Border x:Name="PngChoice" Grid.Column="1" Classes="choice" Margin="6,0,0,0"
                PointerPressed="OnPickPng">
          <TextBlock Text="PNG 位图" FontSize="12" Foreground="{StaticResource Fg.Base}" />
        </Border>
        <RadioButton x:Name="PngRadio" Grid.Column="1" IsHitTestVisible="False"
                     Opacity="0" MinWidth="0" />
      </Grid>
    </StackPanel>

    <!-- 配色 -->
    <StackPanel Grid.Row="2" Margin="0,18,0,0">
      <TextBlock Classes="section" Text="配色" />
      <Grid ColumnDefinitions="*,*">
        <Border x:Name="ColorChoice" Grid.Column="0" Classes="choice" Margin="0,0,6,0"
                PointerPressed="OnPickColor">
          <TextBlock Text="彩色" FontSize="12" Foreground="{StaticResource Fg.Base}" />
        </Border>
        <RadioButton x:Name="ColorRadio" Grid.Column="0" IsHitTestVisible="False"
                     Opacity="0" MinWidth="0" />
        <Border x:Name="PlainChoice" Grid.Column="1" Classes="choice" Margin="6,0,0,0"
                PointerPressed="OnPickPlain">
          <TextBlock x:Name="PlainLabel" Text="黑白 / 剪影" FontSize="12"
                     Foreground="{StaticResource Fg.Base}" />
        </Border>
        <RadioButton x:Name="PlainRadio" Grid.Column="1" IsHitTestVisible="False"
                     Opacity="0" MinWidth="0" />
      </Grid>
    </StackPanel>

    <!-- 分辨率：仅 PNG -->
    <StackPanel x:Name="ScalePanel" Grid.Row="3" Margin="0,18,0,0" Spacing="0">
      <TextBlock Classes="section" Text="分辨率" />
      <ComboBox x:Name="ScaleBox" SelectedIndex="1" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="1× 标准" Tag="1" />
        <ComboBoxItem Content="2× 高清（推荐）" Tag="2" />
        <ComboBoxItem Content="4× 超高（放大细看 / 印刷）" Tag="4" />
      </ComboBox>
      <TextBlock x:Name="SizeHint" FontSize="10.5" Margin="0,8,0,0"
                 Foreground="{StaticResource Fg.Muted}" TextWrapping="Wrap" />
    </StackPanel>

    <TextBlock x:Name="VectorNote" Grid.Row="4" Margin="0,18,0,0" FontSize="10.5"
               Foreground="{StaticResource Fg.Muted}" TextWrapping="Wrap" LineHeight="16"
               Text="SVG 是矢量格式，放大不会失真，因此没有分辨率选项。" />

    <Rectangle Grid.Row="5" Classes="hairline" Margin="0,20,0,0" />

    <StackPanel Grid.Row="6" />
    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,16,0,0" Spacing="8">
      <Button Content="取消" MinWidth="92" Click="OnCancel" />
      <Button Content="导出" MinWidth="92" Click="OnExport" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>