<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="360"
        x:Class="Origami.Desktop.ExportDialog"
        Title="导出" Width="420" Height="360"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bgc.Chrome}">

  <Grid Margin="22" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
               Foreground="{StaticResource Fg.Strong}" />

    <!-- 格式 -->
    <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="0">
      <TextBlock Classes="section" Text="格式" />
      <!-- 两项必须在<b>同一个父容器</b>里：GroupName 的互斥是按「同组+ 同父级」
           查找兄弟的，分到两个 Grid 里就找不到彼此，于是互斥失效。 -->
      <Grid ColumnDefinitions="*,*">
        <RadioButton x:Name="SvgRadio" Grid.Column="0" GroupName="fmt"
                     Theme="{StaticResource SegmentOption}" Margin="0,0,6,0" Content="SVG 矢量" />
        <RadioButton x:Name="PngRadio" Grid.Column="1" GroupName="fmt"
                     Theme="{StaticResource SegmentOption}" Margin="6,0,0,0" Content="PNG 位图" />
      </Grid>
    </StackPanel>

    <!-- 配色 -->
    <StackPanel x:Name="ColorPanel" Grid.Row="2" Margin="0,18,0,0" Spacing="0">
      <TextBlock Classes="section" Text="配色" />
      <Grid ColumnDefinitions="*,*">
        <RadioButton x:Name="ColorRadio" Grid.Column="0" GroupName="clr"
                     Theme="{StaticResource SegmentOption}" Margin="0,0,6,0" Content="彩色" />
        <RadioButton x:Name="PlainRadio" Grid.Column="1" GroupName="clr"
                     Theme="{StaticResource SegmentOption}" Margin="6,0,0,0" Content="黑白 / 剪影" />
      </Grid>
    </StackPanel>

    <!-- 分辨率：仅 PNG -->
    <StackPanel x:Name="ScalePanel" Grid.Row="3" Margin="0,18,0,0" Spacing="0">
      <TextBlock Classes="section" Text="分辨率" />
      <ComboBox x:Name="ScaleBox" SelectedIndex="1" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="1× 标准" Tag="1" />
        <ComboBoxItem Content="2× 高清（推荐）" Tag="2" />
        <ComboBoxItem Content="4× 超高（放大细看 / 印刷）" Tag="4" />
      </ComboBox>
      <TextBlock x:Name="SizeHint" FontSize="10.5" Margin="0,8,0,0"
                 Foreground="{StaticResource Fg.Muted}" TextWrapping="Wrap" />
    </StackPanel>

    <TextBlock x:Name="VectorNote" Grid.Row="4" Margin="0,18,0,0" FontSize="10.5"
               Foreground="{StaticResource Fg.Muted}" TextWrapping="Wrap" LineHeight="16"
               Text="SVG 是矢量格式，放大不会失真，因此没有分辨率选项。" />

    <Rectangle Grid.Row="5" Classes="hairline" Margin="0,20,0,0" />

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,16,0,0" Spacing="8">
      <Button Content="取消" MinWidth="92" Click="OnCancel" />
      <Button Content="导出" MinWidth="92" Click="OnExport" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>