<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Origami.Desktop</RootNamespace>
    <AssemblyName>origami-ui</AssemblyName>
    <StartupObject>Origami.Desktop.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      程序图标：嵌入为 Win32 资源，Windows 才能在任务栏 / 资源管理器 / Alt-Tab
      显示它。仅设 AvaloniaResource 或 Window.Icon 是不够的 —— 那只管窗口内的标题栏。
      icon.ico 含 16/24/32/48/64/128/256 共 7 个尺寸，覆盖任务栏到高 DPI 预览。
    -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- 这里刻意不加 NoWarn 抑制 AVLN3001：ExportDialog 已有无参构造（设计器也需要它），
       警告自然消失，不需要压制。 -->

  <ItemGroup>
    <!--
      icon.png 是打包时从 icon.svg 渲染的 256px 位图 —— Avalonia 无内置 SVG
      解码器，窗口标题图标需要位图，故用它而非矢量源文件。
      icon.svg 与 icon-*.png 保留作设计源与文档用途，不嵌入。
    -->
    <AvaloniaResource Include="Assets\icon.png" />
    <None Include="Assets\icon.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Origami.Core\Origami.Core.csproj" />
  </ItemGroup>

  <!-- 让测试看见 SvgNode 的具体类型（internal，因为它们是预览渲染的实现细节）。
       「方向变换是否真的作用到图元坐标上」只能从类型内部观察，
       为此放宽成public 不划算，故开测试可见性。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Origami.Tests" />
  </ItemGroup>

</Project>
