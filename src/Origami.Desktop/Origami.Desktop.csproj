<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Origami.Desktop</RootNamespace>
    <AssemblyName>origami-ui</AssemblyName>
    <StartupObject>Origami.Desktop.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- 这里刻意不加 NoWarn 抑制 AVLN3001：ExportDialog 已有无参构造（设计器也需要它），
       警告自然消失，不需要压制。 -->

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Origami.Core\Origami.Core.csproj" />
  </ItemGroup>

  <!-- 让测试看见 SvgNode 的具体类型（internal，因为它们是预览渲染的实现细节）。
       「方向变换是否真的作用到图元坐标上」只能从类型内部观察，
       为此放宽成public 不划算，故开测试可见性。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Origami.Tests" />
  </ItemGroup>

</Project>
