<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Origami.Tests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!--
      无头Avalonia：让 XAML 冒烟测试能在无显示环境里真正实例化窗口。
      XAML 的错误（StaticResource 找不到、绑定写错）编译器查不出来，
      只有把窗口 new 出来 + Show 才会暴露 —— 见 UiSmokeTests。
    -->
    <PackageReference Include="Avalonia.Headless" Version="11.2.3" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Origami.Core\Origami.Core.csproj" />
    <!-- GUI 侧的纯逻辑（视口缩放/平移、SVG 导入判定）也要能测，
         所以引用 Desktop 程序集。这些类型不碰 Avalonia 控件状态，
         在无显示环境下也能实例化和调用。 -->
    <ProjectReference Include="..\..\src\Origami.Desktop\Origami.Desktop.csproj" />
  </ItemGroup>

  <!-- 旧参考实现（JavaScript）导出的基准数据，用于算法一致性核对。
       由 Node 直接运行旧代码导出，不含手工转录：
       legacy_font.json 单字模的编码与折痕（比字模层）
       legacy_text.json多字符文本的完整编码流程（比文本层） -->
  <ItemGroup>
    <None Include="legacy_font.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="legacy_text.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 权威题面基准（方形 CP 折痕图），作为回归测试的黄金样本 -->
  <ItemGroup>
    <None Include="square_truth.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="square_truth_protein.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>